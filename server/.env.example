# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/formdb

# JWT
JWT_SECRET=your-super-secret-jwt-key

# 服务端口
PORT=3000

# 飞书集成
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 表单1 飞书表格
FORM1_APP_TOKEN=bascnxxxxxxxxxx
FORM1_TABLE_ID=tblxxxxxxxxxx

# 表单2 飞书表格
FORM2_APP_TOKEN=bascnxxxxxxxxxx
FORM2_TABLE_ID=tblxxxxxxxxxx

# 开发模式（启用固定验证码）
NODE_ENV=development
