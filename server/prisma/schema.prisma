generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                Int               @id @default(autoincrement())
  username          String            @unique
  phone             String            @unique
  passwordHash      String            @map("password_hash")
  role              String            @default("user")
  gender            String?
  birthDate         String?           @map("birth_date")
  emergencyName     String?           @map("emergency_name")
  emergencyRelation String?           @map("emergency_relation")
  emergencyPhone    String?           @map("emergency_phone")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  form1Submissions  Form1Submission[]
  form2Submissions  Form2Submission[]

  @@index([phone])
  @@index([role])
  @@map("users")
}

model Form1Submission {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  orderNo          String   @unique @map("order_no")
  name             String
  phone            String
  consultationType String   @map("consultation_type")
  preferredDate    String   @map("preferred_date")
  preferredTime    String   @map("preferred_time")
  brief            String
  submittedBy      String   @map("submitted_by")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  versionNumber    Int      @map("version_number")
  feishuRecordId   String?  @map("feishu_record_id")
  feishuSyncStatus String   @default("pending") @map("feishu_sync_status")
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([feishuSyncStatus])
  @@index([submittedAt])
  @@index([orderNo])
  @@map("form1_submissions")
}

model Form2Submission {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  orderNo          String   @unique @map("order_no")
  name             String
  phone            String
  submittedBy      String   @map("submitted_by")
  formData         String   @map("form_data")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  versionNumber    Int      @map("version_number")
  feishuRecordId   String?  @map("feishu_record_id")
  feishuSyncStatus String   @default("pending") @map("feishu_sync_status")
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([feishuSyncStatus])
  @@index([submittedAt])
  @@index([orderNo])
  @@map("form2_submissions")
}
